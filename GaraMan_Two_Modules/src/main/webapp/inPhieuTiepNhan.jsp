<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.sql.*" %><%
int id=Integer.parseInt(request.getParameter("id"));String ten="",sdt="",bienSo="",kyThuat="",moTa="";java.math.BigDecimal tong=java.math.BigDecimal.ZERO;
try(Connection c=vn.garaman.config.DB.getConnection();PreparedStatement p=c.prepareStatement("SELECT p.*,t.hoTen,t.soDienThoai,nv.hoTen kyThuat FROM tblPhieuTiepNhan p JOIN tblKhachHang k ON p.khachHangId=k.id JOIN tblThanhVien t ON k.id=t.id JOIN tblNhanVien n ON p.nvKyThuatId=n.id JOIN tblThanhVien nv ON n.id=nv.id WHERE p.id=?")){p.setInt(1,id);try(ResultSet r=p.executeQuery()){if(r.next()){ten=r.getString("hoTen");sdt=r.getString("soDienThoai");bienSo=r.getString("bienSoXe");kyThuat=r.getString("kyThuat");moTa=r.getString("moTaTinhTrang");tong=r.getBigDecimal("tongTien");}}}
%><!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><title>Phiếu tiếp nhận #<%=id%></title></head><body><h2>GARAMAN - PHIẾU TIẾP NHẬN XE</h2><p>Mã phiếu: <%=id%></p><p>Khách hàng: <%=ten%> - <%=sdt%></p><p>Biển số xe: <%=bienSo%></p><p>Kỹ thuật viên: <%=kyThuat%></p><p>Tình trạng: <%=moTa%></p><h3>Tổng tiền dự kiến: <%=tong%> VNĐ</h3><button onclick="window.print()">In phiếu</button></body></html>
